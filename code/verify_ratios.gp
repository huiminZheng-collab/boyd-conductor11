default(realprecision, 80);
\\ ntilde(k)/m(k) values from ntilde_family.py (mpmath, 80 dps) -- k=1,2,3 now 70 digits
ntm3 = 0.970767075929641590831458;
ntm2 = 0.721282593073082217909532;
ntm1 = -0.46493780021441118890735356443424857552297430198564;
nt0  = -0.15214714172591804948622729747863449562814358916423;
nt1  = 0.2993555868829153900537997476900314506297359559449363413222682315733418;
nt2  = 0.7152409322549952999978851384275938877299377108917413331954984202448486;
nt3  = 1.071496734340351607053771623313303582385727533552295407430261340076935;
mm2  = 0.721282593073082217909532;
mm1  = 0.50926262288824211511625928008401754294373479778084;
m0   = 0.405602955915010403908189961285;
m1   = 0.5065621149880197913995283765424319629804714983109679710371802115380156;
m2   = 0.7152409322549952999978851384275938877299377108917413331954984202448486;
m3   = 1.071496734340351607053771623313303582385727533552295407430261340076935;

rat(v, b) = { my(r); if(b==0, return("  b=0")); r = v/b;
  return(concat(Strprintf("%.30f", r), concat("   bestappr: ", Str(bestappr(r, 10^6))))); };

doit(kk, nt, mm) = {
  my(E, N, Em, b);
  E = ellinit(ellfromeqn(y^2 + (x^2+kk*x+1)*y + x^3));
  N = ellglobalred(E)[1];
  Em = ellminimalmodel(E);
  b = abs(lfun(Em, 0, 1));      \\ |L'(E,0)|, sign tells root number
  print("\nk=", kk, "  N=", N, "  j=", E.j, "  L'(E,0)=", lfun(Em,0,1));
  print("   |nt|/b: ", rat(abs(nt), b));
  print("   m/b   : ", rat(mm, b));
  print("   lindep[nt,b]: ", lindep([nt, b]));
  print("   lindep[m ,b]: ", lindep([mm, b]));
};
doit(-3, ntm3, m3*0+0.970767075929641590831458);
doit(-2, ntm2, mm2);
doit(-1, ntm1, mm1);
doit(0, nt0, m0);
doit(1, nt1, m1);
doit(2, nt2, m2);
doit(3, nt3, m3);
quit
